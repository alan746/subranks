{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "subranks-demo",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "preview.html",
        "height": "regular",
        "inline": true
      },
      "app": {
        "entry": "index.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "entry": "dist/server/index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "moderator",
      "asUser": ["SUBSCRIBE_TO_SUBREDDIT"]
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/app-install",
    "onCommentCreate": "/internal/triggers/comment-create",
    "onCommentDelete": "/internal/triggers/comment-delete"
  },
  "menu": {
    "items": [
      {
        "label": "Create SubRanks post",
        "description": "Create the community rank dashboard and daily check-in post",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/create-post"
      }
    ]
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
